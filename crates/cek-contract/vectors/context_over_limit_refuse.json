{
  "id": "context-over-limit-refuse",
  "family": "context",
  "description": "LAW §8: limit only narrows; over-limit submit is authority_refusal with empty Ops",
  "now": 1000,
  "inject": { "activity_id": "act-1", "names": ["kv"] },
  "limit": { "activity_id": "act-1", "names": ["kv:greeting"] },
  "intent": {
    "action": "kv.write",
    "args": { "key": "other", "value": 1 },
    "activity_id": "act-1",
    "cap": { "id": "cap-ctx-lim", "action": "kv.write", "once": false }
  },
  "expect_kind": "authority_refusal",
  "expect_ops_empty": true
}
